# App settings
APP_NAME=SQRL
ENVIRONMENT=development
LOG_LEVEL=INFO
VERSION=0.1.0

# LLM API Keys
GEMINI_API_KEY_V1=AQ.Ab8...
GROQ_API_KEY_V1=gsk_x1P...
OPENROUTER_API_KEY_V1=sk-...

# LangSmith Settings
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="Add your api key"
LANGSMITH_PROJECT="CSI_Mapping"

# GitHub Token
GITHUB_TOKEN="github_pat_11A..."

# MinIO settings
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=strongpassword123
MINIO_BUCKET=squirrel

# Database settings
DATABASE_URL=postgresql://squirrel:squirrel_password@postgres:5432/squirrel

# Processing Settings
MIN_PROCESS_COUNT=15
MIN_WORKER_COUNT=15

# Fernet key used to encrypt stored provider tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=fJ1LHEz9podTBketKu2BgTqe8XrYveBWRCemEVvhn7U=

# Fernet key used to encrypt connector secrets at rest. Generate the same way
# as TOKEN_ENCRYPTION_KEY; use a different value.
SQUIRREL_CONNECTOR_SECRET_KEY=

# Bootstrap admin (opt-in). Leave disabled and register the first user via
# POST /api/auth/register instead of shipping a known admin password.
CREATE_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@squirrel.local
DEFAULT_ADMIN_PASSWORD=
