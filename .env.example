# App settings
APP_NAME=SQRL
ENVIRONMENT=development
LOG_LEVEL=INFO
VERSION=0.1.0

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Gemini AI settings
GEMINI_API_KEY_V1=AIza...

# Groq AI settings
GROQ_API_KEY_V1=gsk_qko...

# MinIO settings
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=strongpassword123
MINIO_BUCKET=squirrel

# Database settings
DATABASE_URL=postgresql://squirrel:squirrel_password@postgres:5432/squirrel

# Background jobs (Celery + Redis)
REDIS_URL=redis://redis:6379/0
# Optional explicit overrides; both default to REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Email notifications (disabled by default).
NOTIFICATIONS_ENABLED=false
APP_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@squirrel.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ETL pipelines (Phase 1). Every Postgres destination must start with
# ETL_SINK_TABLE_PREFIX unless it appears in ETL_ALLOWED_SINK_TABLES; every
# app-table source must start with ETL_SOURCE_TABLE_PREFIXES unless it appears
# in ETL_ALLOWED_SOURCE_TABLES. Platform-owned tables are always rejected.
ETL_ENABLED=true
ETL_SINK_TABLE_PREFIX=etl_
ETL_SOURCE_TABLE_PREFIXES=etl_
ETL_ALLOWED_SINK_TABLES=
ETL_ALLOWED_SOURCE_TABLES=
ETL_MINIO_PREFIX=etl/
ETL_MAX_SOURCE_ROWS=500000
ETL_MAX_STEPS=100

# Processing Settings
MIN_PROCESS_COUNT=15
MIN_WORKER_COUNT=15

# Fernet key used to encrypt stored provider tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=fJ1...

# Fernet key used to encrypt connector secrets at rest. Generate the same way
# as TOKEN_ENCRYPTION_KEY; use a different value.
SQUIRREL_CONNECTOR_SECRET_KEY=

# Databricks SQL warehouse (required for /api/warehouse endpoints).
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=

# Directory watched by Airflow for generated DAG files.
AIRFLOW_DAGS_DIR=airflow/dags

# Bootstrap admin (opt-in). Leave disabled and register the first user via
# POST /api/auth/register instead of shipping a known admin password.
CREATE_DEFAULT_ADMIN=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@squirrel.local
DEFAULT_ADMIN_PASSWORD=
